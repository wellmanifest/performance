{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/performance-plan/v1",
  "title": "Wellmanifest Performance plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "profiles", "workload", "baseline", "candidate", "budgets", "invariants", "strategy", "rollout", "rollback", "authority"],
  "properties": {
    "schema": {"const": "performance.plan/v1"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "component"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "component": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repository", "developer-workstation", "runtime-service", "high-throughput-runtime"]}},
    "workload": {"$ref": "#/$defs/workload"},
    "baseline": {"$ref": "#/$defs/measurement"},
    "candidate": {"$ref": "#/$defs/measurement"},
    "budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/budget"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}},
    "strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "rationale", "changedPaths", "compatibility"],
      "properties": {
        "outcome": {"enum": ["no_change", "configuration", "packaging", "same_language", "protocol", "selective_native", "bounded_replacement"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000, "not": {"pattern": "(^|[;&|])\\s*(sudo|sh|bash|zsh|pwsh|cmd)(\\s|$)"}},
        "changedPaths": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}}},
        "compatibility": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "rollout": {"$ref": "#/$defs/boundedAction"},
    "rollback": {"$ref": "#/$defs/boundedAction"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["requestOnly", "executionGrantEmbedded"],
      "properties": {
        "requestOnly": {"const": true},
        "executionGrantEmbedded": {"const": false}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "maxLength": 1000, "not": {"pattern": "([Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt])="}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "method", "warmup", "samples", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "method": {"type": "string", "minLength": 1, "maxLength": 1000},
        "warmup": {"type": "string", "minLength": 1, "maxLength": 500},
        "samples": {"type": "integer", "minimum": 3, "maximum": 100000},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
        "unit": {"enum": ["ns", "us", "ms", "s", "bytes", "bytes_per_second", "operations_per_second", "percent", "count"]},
        "value": {"type": "number"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["workloadId", "metrics", "evidence"],
      "properties": {
        "workloadId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "unit", "comparison", "threshold"],
      "properties": {
        "metric": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
        "unit": {"enum": ["ns", "us", "ms", "s", "bytes", "bytes_per_second", "operations_per_second", "percent", "count"]},
        "comparison": {"enum": ["at_most", "at_least"]},
        "threshold": {"type": "number"}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "verification", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "kind": {"enum": ["functional", "security", "resource", "authority", "availability", "compatibility"]},
        "verification": {"type": "string", "minLength": 1, "maxLength": 1000},
        "required": {"const": true}
      }
    },
    "boundedAction": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanism", "scope", "observationSeconds", "abortThreshold"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1, "maxLength": 1000, "not": {"pattern": "(^|[;&|])\\s*(sudo|sh|bash|zsh|pwsh|cmd)(\\s|$)"}},
        "scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "observationSeconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "abortThreshold": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
