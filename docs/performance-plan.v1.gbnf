root ::= "{" ws schema comma subject comma profiles comma workload-field comma baseline comma candidate comma budgets comma invariants comma strategy comma rollout comma rollback comma authority ws "}"
schema ::= q "schema" q colon q "performance.plan/v1" q
subject ::= q "subject" q colon "{" ws q "repository" q colon identifier comma q "revision" q colon sha40 comma q "component" q colon safe-string ws "}"
profiles ::= q "profiles" q colon "[" ws profile (comma profile)* ws "]"
profile ::= q ("repository" | "developer-workstation" | "runtime-service" | "high-throughput-runtime") q
workload-field ::= q "workload" q colon workload
workload ::= "{" ws q "id" q colon identifier comma q "description" q colon safe-string comma q "method" q colon safe-string comma q "warmup" q colon safe-string comma q "samples" q colon positive-integer comma q "evidence" q colon evidence ws "}"
baseline ::= q "baseline" q colon measurement
candidate ::= q "candidate" q colon measurement
measurement ::= "{" ws q "workloadId" q colon identifier comma q "metrics" q colon metrics comma q "evidence" q colon evidence ws "}"
metrics ::= "[" ws metric (comma metric)* ws "]"
metric ::= "{" ws q "name" q colon identifier comma q "unit" q colon unit comma q "value" q colon number ws "}"
budgets ::= q "budgets" q colon "[" ws budget (comma budget)* ws "]"
budget ::= "{" ws q "metric" q colon identifier comma q "unit" q colon unit comma q "comparison" q colon q ("at_most" | "at_least") q comma q "threshold" q colon number ws "}"
invariants ::= q "invariants" q colon "[" ws invariant (comma invariant)* ws "]"
invariant ::= "{" ws q "id" q colon identifier comma q "kind" q colon kind comma q "verification" q colon safe-string comma q "required" q colon "true" ws "}"
strategy ::= q "strategy" q colon "{" ws q "outcome" q colon outcome comma q "rationale" q colon safe-string comma q "changedPaths" q colon paths comma q "compatibility" q colon safe-string ws "}"
paths ::= "[" ws (relative-path (comma relative-path)*)? ws "]"
rollout ::= q "rollout" q colon bounded-action
rollback ::= q "rollback" q colon bounded-action
bounded-action ::= "{" ws q "mechanism" q colon safe-string comma q "scope" q colon safe-string comma q "observationSeconds" q colon positive-integer comma q "abortThreshold" q colon safe-string ws "}"
authority ::= q "authority" q colon "{" ws q "requestOnly" q colon "true" comma q "executionGrantEmbedded" q colon "false" ws "}"
evidence ::= "{" ws q "uri" q colon uri comma q "sha256" q colon sha64 ws "}"
outcome ::= q ("no_change" | "configuration" | "packaging" | "same_language" | "protocol" | "selective_native" | "bounded_replacement") q
kind ::= q ("functional" | "security" | "resource" | "authority" | "availability" | "compatibility") q
unit ::= q ("ns" | "us" | "ms" | "s" | "bytes" | "bytes_per_second" | "operations_per_second" | "percent" | "count") q
identifier ::= q [A-Za-z0-9_.-]+ q
relative-path ::= q [A-Za-z0-9_./-]+ q
uri ::= q [A-Za-z0-9_./:@%?+-]+ q
safe-string ::= q safe-char+ q
safe-char ::= [A-Za-z0-9_ ./,:()@%+?=!-]
sha40 ::= q hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex q
sha64 ::= q hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex q
positive-integer ::= [1-9] [0-9]*
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
hex ::= [0-9a-f]
q ::= "\""
colon ::= ws ":" ws
comma ::= ws "," ws
ws ::= [ \t\n\r]*
